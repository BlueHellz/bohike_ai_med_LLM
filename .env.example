# Restart the uvicorn server after editing .env so variables are reloaded.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional — required for surgeon tier and Claude fallback when LLM_PROVIDER is not deepseek
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-5

# Set to deepseek for DeepSeek-only operation (no Claude calls)
LLM_PROVIDER=deepseek

DB_URL=sqlite+aiosqlite:///./aegis.db

ROLLING_SUMMARY_MAX_TOKENS=300
RECENT_TURNS_K=5
PATIENT_RESPONSE_MAX_TOKENS=200
CLINICIAN_SUMMARY_MAX_TOKENS=250

# Voice channel: defer rolling-summary LLM call (saves ~15–45s before TTS)
VOICE_SKIP_SUMMARY=true
VOICE_REASONING_MAX_TOKENS=650
VOICE_PATIENT_RESPONSE_MAX_TOKENS=120

# Patient data: fixture (fixtures/patients.json) or http (not yet implemented)
# Legacy alias: mock
PATIENT_DATA_PROVIDER=fixture
PATIENT_BACKEND_URL=

LOG_LEVEL=INFO
MOCK_LLM=

# Local test-ui without DeepSeek: set true when DEEPSEEK_API_KEY is empty
DEV_STUB_LLM=true

# Temporary manual test UI at /test-ui/ — disable before production
TEST_UI_ENABLED=true

# Local Piper TTS for test-ui playback (localhost WAV synthesis, not cloud)
LOCAL_TTS_ENABLED=false
# LOCAL_TTS_VOICES_DIR=voices/piper
# Speech rate (default 0.92); 1.0 = model default
# Piper prosody (conversational pace): length_scale >1 = slower
# LOCAL_TTS_LENGTH_SCALE=1.12
# LOCAL_TTS_SENTENCE_SILENCE=0.42
# LOCAL_TTS_NOISE_SCALE=0.667
# LOCAL_TTS_NOISE_W=0.78
