{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Unified Training Record",
  "description": "Normalized JSONL record after pipeline stage 04 (structuring)",
  "type": "object",
  "required": ["source", "text", "type", "metadata"],
  "properties": {
    "source": {
      "type": "string",
      "description": "Dataset identifier (e.g. mimic_iv_note, meddialog)"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Combined clinical text content"
    },
    "type": {
      "type": "string",
      "enum": ["clinical_note", "dialogue", "qa", "guideline"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "specialty": { "type": "string" },
        "encounter_type": { "type": "string" },
        "risk_level": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
