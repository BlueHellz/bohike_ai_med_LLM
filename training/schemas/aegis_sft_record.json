{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS SFT Training Record",
  "description": "Supervised fine-tuning row mapping to ReasoningOutput + ClinicalContext",
  "type": "object",
  "required": ["messages", "ideal"],
  "properties": {
    "messages": {
      "type": "array",
      "description": "Chat-style input aligned with DeepSeek fine-tune API",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    },
    "ideal": {
      "type": "object",
      "description": "Target ReasoningOutput JSON (app/schemas.py)",
      "required": ["patient_response_text", "clinician_layer", "safety"],
      "properties": {
        "patient_response_text": { "type": "string" },
        "clinician_layer": {
          "type": "object",
          "required": [
            "summary",
            "key_findings",
            "differential_considerations",
            "working_diagnosis_areas",
            "risk_flags",
            "followup_questions",
            "recommended_physician_actions",
            "confidence_level"
          ],
          "properties": {
            "summary": { "type": "string" },
            "key_findings": { "type": "array", "items": { "type": "string" } },
            "differential_considerations": { "type": "array", "items": { "type": "string" } },
            "working_diagnosis_areas": { "type": "array", "items": { "type": "string" } },
            "risk_flags": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "severity", "rationale"],
                "properties": {
                  "type": { "type": "string" },
                  "severity": { "type": "string", "enum": ["low", "medium", "high"] },
                  "rationale": { "type": "string" }
                }
              }
            },
            "followup_questions": { "type": "array", "items": { "type": "string" } },
            "recommended_physician_actions": { "type": "array", "items": { "type": "string" } },
            "confidence_level": { "type": "string", "enum": ["low", "medium", "high"] }
          }
        },
        "safety": {
          "type": "object",
          "required": ["should_escalate", "requires_physician_review", "emergency_detected"],
          "properties": {
            "should_escalate": { "type": "boolean" },
            "escalation_reason": { "type": ["string", "null"] },
            "requires_physician_review": { "type": "boolean" },
            "emergency_detected": { "type": "boolean" }
          }
        }
      }
    },
    "clinical_context": {
      "type": "object",
      "description": "Optional ClinicalContext snapshot for traceability"
    }
  },
  "additionalProperties": false
}
